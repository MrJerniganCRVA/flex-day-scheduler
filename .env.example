# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Supabase, Railway, etc.)
DATABASE_URL="postgresql://username:password@host:5432/flexday_scheduler?schema=public"

# ─── NextAuth.js ─────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# ─── Google OAuth (for user login via NextAuth.js) ───────────────────────────
# From Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
# Authorized redirect URIs must include: {NEXTAUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID="your-google-oauth-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-oauth-client-secret"

# ─── Google Calendar ─────────────────────────────────────────────────────────
# No extra credentials. Calendar invites are created by the teacher covering each
# block, over OAuth, using the AUTH_GOOGLE_* client above — Google refuses to let
# a service account invite attendees without Domain-Wide Delegation of Authority.
#
# Two things must be set on that OAuth client in Google Cloud Console:
#   1. OAuth consent screen → add the scope
#      https://www.googleapis.com/auth/calendar.events
#      (User type must be Internal; an External app needs Google verification
#      before a sensitive scope like this works for real users.)
#   2. Credentials → the OAuth 2.0 Client ID → Authorized redirect URIs → add
#      {NEXTAUTH_URL}/api/calendar/callback
#
# Each teacher then allows access once, from their own dashboard.
#
# GOOGLE_SERVICE_ACCOUNT_EMAIL / GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY are no longer
# read. They can be deleted from an existing deployment.

# ─── App Configuration ───────────────────────────────────────────────────────
# Only users with this email domain can sign in
ALLOWED_EMAIL_DOMAIN="coderva.org"

# School timezone (IANA timezone name)
SCHOOL_TIMEZONE="America/New_York"

# Rotation times — used for Google Calendar event creation
# Update these before going live with actual school bell times
FLEX_1_START="09:00"
FLEX_1_END="09:50"
FLEX_2_START="10:00"
FLEX_2_END="10:50"
FLEX_3_START="11:00"
FLEX_3_END="11:50"

# ─── First Admin ──────────────────────────────────────────────────────────────
# Email to promote to ADMIN on first database seed (run: npx prisma db seed)
SEED_ADMIN_EMAIL="admin@coderva.org"
