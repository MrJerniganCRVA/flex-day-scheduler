generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum RotationSlot {
  FLEX_1
  FLEX_2
  FLEX_3
}

enum SignupAuditAction {
  ADD
  MOVE
  REMOVE
}

// ─── NextAuth required models ─────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Application models ───────────────────────────────────────────────────────

/// Single-row table for app-owned state that has no natural parent record.
/// The `id` is pinned to "singleton" (enforced by a CHECK constraint in the
/// migration) so callers can upsert against a known key without first
/// querying for a row that may not exist yet.
model AppConfig {
  id String @id @default("singleton")

  /// Google Calendar that hosts events for one-off sessions. One-off sessions
  /// have no club, so they have no club calendar to live on. Created lazily on
  /// the first finalize that needs it and never ACL-shared with anyone — the
  /// owning teacher is added as an event attendee instead, which is all that's
  /// needed to put it on their personal calendar.
  oneOffCalendarId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  image         String?
  emailVerified DateTime?
  role          Role      @default(STUDENT)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  clubsOwned       Club[]                    @relation("ClubOwner")
  cosponsoredClubs Club[]                    @relation("ClubCosponsor")
  signups          Signup[]
  rotCovPrimary    SessionRotationCoverage[] @relation("RotCovPrimary")
  rotCovSecondary  SessionRotationCoverage[] @relation("RotCovSecondary")
  oneOffSessions   ClubSession[]             @relation("OneOffOwner")
  auditsPerformed  SignupAudit[]             @relation("SignupAuditActor")
  auditsAbout      SignupAudit[]             @relation("SignupAuditStudent")
  clubTeacherPools ClubTeacher[]             @relation("ClubTeacherPool")
  sessionAbsences  SessionTeacherAbsence[]   @relation("SessionAbsence")
  dutyAssignments  DutyAssignment[]          @relation("DutyTeacher")

  @@index([email])
}

model FlexDay {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  label       String?
  isActive    Boolean  @default(true)
  isFinalized Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clubSessions    ClubSession[]
  dutyAssignments DutyAssignment[]

  @@unique([date])
  @@index([date])
}

model Room {
  id        String   @id @default(cuid())
  name      String   @unique
  capacity  Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clubsWithDefault Club[]        @relation("DefaultRoom")
  sessionOverrides ClubSession[] @relation("SessionRoom")

  @@index([name])
}

model Club {
  id               String         @id @default(cuid())
  name             String
  description      String?
  maxCapacity      Int
  defaultRoomId    String?
  defaultRotations RotationSlot[]
  linkedRotations  Boolean        @default(true)
  googleCalendarId String?        @unique

  /// Optional. A club may have no owner at all: some clubs are run by a rotation
  /// of teachers with no single person responsible, and forcing one to be named
  /// made that teacher read as the club's permanent instructor everywhere.
  /// Ownership is an administrative role — who may edit the club. Who actually
  /// stands in the room is answered by SessionRotationCoverage per session, with
  /// the owner and cosponsor acting only as defaults (see src/lib/coverage.ts).
  /// A club with no owner is admin-managed.
  ownerId String?

  cosponsorId           String?
  allowRandomAssignment Boolean   @default(true)
  calendarSharedAt      DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  /// Restrict, not SetNull: deleting a teacher must not quietly detach their
  /// clubs. An admin clears or reassigns ownership first, deliberately.
  owner        User?         @relation("ClubOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  cosponsor    User?         @relation("ClubCosponsor", fields: [cosponsorId], references: [id], onDelete: SetNull)
  defaultRoom  Room?         @relation("DefaultRoom", fields: [defaultRoomId], references: [id], onDelete: SetNull)
  clubSessions ClubSession[]
  teachers     ClubTeacher[]

  @@index([ownerId])
  @@index([cosponsorId])
  @@index([defaultRoomId])
}

/// The pool of teachers who rotate through a club.
///
/// Deliberately separate from owner/cosponsor, which are *management* roles.
/// Pool membership means "expect to see this person running this club sometimes";
/// it grants no permission to edit the club. It exists so a club with four
/// teachers taking turns can record that fact once, instead of an admin
/// re-deriving it from scratch on every flex day.
model ClubTeacher {
  id        String   @id @default(cuid())
  clubId    String
  teacherId String
  createdAt DateTime @default(now())

  club    Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  teacher User @relation("ClubTeacherPool", fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([clubId, teacherId])
  @@index([clubId])
  @@index([teacherId])
}

model ClubSession {
  id               String         @id @default(cuid())
  flexDayId        String
  clubId           String?
  rotations        RotationSlot[]
  roomOverrideId   String?
  googleEventId    String?
  title            String?
  capacityOverride Int?
  oneOffOwnerId    String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  flexDay          FlexDay                   @relation(fields: [flexDayId], references: [id], onDelete: Cascade)
  club             Club?                     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  roomOverride     Room?                     @relation("SessionRoom", fields: [roomOverrideId], references: [id], onDelete: SetNull)
  oneOffOwner      User?                     @relation("OneOffOwner", fields: [oneOffOwnerId], references: [id], onDelete: SetNull)
  signups          Signup[]
  rotationCoverage SessionRotationCoverage[]
  teacherAbsences  SessionTeacherAbsence[]

  @@index([flexDayId])
  @@index([clubId])
  @@index([roomOverrideId])
  @@index([oneOffOwnerId])
}

model SessionRotationCoverage {
  id                 String       @id @default(cuid())
  sessionId          String
  rotation           RotationSlot
  primaryTeacherId   String?
  secondaryTeacherId String?

  /// The admin has explicitly decided this rotation needs no second teacher.
  ///
  /// Distinct from `secondaryTeacherId = null`, which means "nobody assigned — use
  /// the club's cosponsor if it has one". The two cannot be told apart from the
  /// null alone: rows are upserted per field, so setting T1 creates a row whose
  /// secondary is null purely as a side effect. Without this flag there is no way
  /// to clear T2 on a club that has a cosponsor — the fallback re-derives them.
  secondaryCleared Boolean @default(false)

  /// The same decision for T1: this rotation's primary teacher is nobody.
  ///
  /// Added after the flag above, for a bug with the identical shape one slot over.
  /// `primaryTeacherId = null` means "nobody assigned — use the club's owner", so
  /// clearing T1 on a club that has an owner was impossible: the Coverage page
  /// saved the null happily and the fallback put the owner straight back on the
  /// next load. That left an admin no way to take a double-booked teacher off one
  /// of the two clubs they were expected at simultaneously.
  ///
  /// Use this when the *slot* should be empty and the rotation should show as
  /// needing cover. When a specific person simply is not attending — the usual
  /// case for a double-booking — a SessionTeacherAbsence is the better record: it
  /// names who and why, and survives a change of club owner.
  primaryCleared Boolean @default(false)

  session          ClubSession @relation(fields: [sessionId],          references: [id], onDelete: Cascade)
  primaryTeacher   User?       @relation("RotCovPrimary",   fields: [primaryTeacherId],   references: [id], onDelete: SetNull)
  secondaryTeacher User?       @relation("RotCovSecondary", fields: [secondaryTeacherId], references: [id], onDelete: SetNull)

  @@unique([sessionId, rotation])
  @@index([primaryTeacherId])
  @@index([secondaryTeacherId])
}

/// A teacher who will not be attending a session they would otherwise be
/// expected at — typically because they are double-booked and can only be in one
/// room during that rotation.
///
/// This has to be recorded explicitly rather than by clearing a coverage row,
/// because the teacher is often the club's owner and therefore the *implicit*
/// default: deleting the row wouldn't remove them, the fallback in
/// src/lib/coverage.ts would put them straight back. An absence is subtracted
/// after those fallbacks are applied.
///
/// Replaces the old ClubSession.teacherAbsent boolean, which could not say which
/// teacher was out — an ambiguity that became unworkable once a session could
/// have an owner, a cosponsor, and per-rotation coverage.
///
/// An absence never cancels the session: the club still runs, and the rotation
/// simply shows as needing coverage to admins.
model SessionTeacherAbsence {
  id        String       @id @default(cuid())
  sessionId String
  teacherId String
  /// Required rather than nullable: Postgres treats NULLs as distinct in a
  /// unique index, so a nullable "all rotations" value would allow duplicate
  /// rows. A teacher absent from a linked session gets one row per rotation.
  rotation  RotationSlot
  reason    String?
  createdAt DateTime     @default(now())

  session ClubSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  teacher User        @relation("SessionAbsence", fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([sessionId, teacherId, rotation])
  @@index([sessionId])
  @@index([teacherId])
}

model Signup {
  id            String   @id @default(cuid())
  studentId     String
  clubSessionId String
  attended      Boolean?
  createdAt     DateTime @default(now())

  student     User        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  clubSession ClubSession @relation(fields: [clubSessionId], references: [id], onDelete: Cascade)

  @@unique([studentId, clubSessionId])
  @@index([studentId])
  @@index([clubSessionId])
}

/// Immutable record of an admin overriding a roster after calendar invites went
/// out. Deliberately denormalized: session and flex-day rows get deleted in the
/// normal course of business (deleting a flex day cascades its sessions), and an
/// audit trail that loses its meaning when the thing it describes is deleted is
/// not an audit trail. Names and dates are captured at write time; the optional
/// id columns are for linking while the referenced rows still exist.
model SignupAudit {
  id     String            @id @default(cuid())
  action SignupAuditAction

  /// Free-text justification, required at the API boundary (e.g. "no permission
  /// slip on file"). This is the field that answers a parent's question.
  reason String

  actorId    String?
  actorEmail String

  studentId   String?
  studentName String

  /// Session moved out of (MOVE/REMOVE) and into (MOVE/ADD). Plain columns, not
  /// foreign keys — see the note above about sessions being deleted.
  fromSessionId   String?
  fromSessionName String?
  toSessionId     String?
  toSessionName   String?

  flexDayId   String?
  flexDayDate DateTime @db.Date

  createdAt DateTime @default(now())

  actor   User? @relation("SignupAuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  student User? @relation("SignupAuditStudent", fields: [studentId], references: [id], onDelete: SetNull)

  @@index([flexDayId])
  @@index([studentId])
  @@index([createdAt])
}

/// A supervision post that is not a club: a hallway, the cafeteria, the front
/// doors. Somewhere a teacher has to stand so the building has adequate eyes.
///
/// Deliberately NOT a ClubSession. Everything student-facing reaches sessions
/// through `flexDay.clubSessions` or `signup.clubSession` — the student pages,
/// signups, the roster CSV export, auto-assign and calendar finalize — so a
/// separate model is invisible to all of them with no changes to any of those
/// queries. Modelling duty as a club with a flag would instead require a correct
/// exclusion in every one of those places, and the first one missed would offer a
/// hallway to students as something to sign up for, or auto-assign a student into
/// it: Club.allowRandomAssignment defaults to true.
model DutyPost {
  id   String  @id @default(cuid())
  name String  @unique
  /// Free text ("2nd floor hallway", "front doors"). Deliberately not a Room
  /// relation: most duty spots are corridors and doors, not bookable rooms.
  location String?

  /// Rotations this post MUST be staffed for.
  ///
  /// Not a "default" that gets copied onto each day the way Club.defaultRotations
  /// is — it is the standing requirement, read live. It is what lets an unstaffed
  /// cafeteria show as a gap without an admin having to remember the cafeteria
  /// should be staffed, and it keeps "nobody needed here in Flex 2" distinct from
  /// "nobody assigned yet in Flex 2". That distinction is the same one whose
  /// absence caused the coverage T1 bug — see SessionRotationCoverage.
  requiredRotations RotationSlot[]

  /// Retirement path. Deleting a post cascades its assignments and erases the
  /// record of who covered it; deactivating stops it appearing on future Flex
  /// Days and keeps the history. Mirrors Room.isActive.
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments DutyAssignment[]
}

/// Who is covering one duty post, for one rotation of one Flex Day.
///
/// Unlike SessionRotationCoverage there is no fallback chain here: a duty post
/// has no owner or cosponsor to derive from, so a null teacher unambiguously
/// means "unstaffed" and no `cleared` flag is needed.
model DutyAssignment {
  id         String       @id @default(cuid())
  dutyPostId String
  flexDayId  String
  rotation   RotationSlot
  teacherId  String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  dutyPost DutyPost @relation(fields: [dutyPostId], references: [id], onDelete: Cascade)
  flexDay  FlexDay  @relation(fields: [flexDayId], references: [id], onDelete: Cascade)
  /// SetNull, not Cascade: deleting a teacher must leave the post visibly
  /// unstaffed rather than silently dropping the requirement to staff it.
  teacher  User?    @relation("DutyTeacher", fields: [teacherId], references: [id], onDelete: SetNull)

  @@unique([dutyPostId, flexDayId, rotation])
  @@index([flexDayId])
  @@index([teacherId])
}
