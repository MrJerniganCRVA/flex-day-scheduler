generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum RotationSlot {
  FLEX_1
  FLEX_2
  FLEX_3
}

// ─── NextAuth required models ─────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Application models ───────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  image         String?
  emailVerified DateTime?
  role          Role      @default(STUDENT)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts        Account[]
  sessions        Session[]
  clubsOwned      Club[]                    @relation("ClubOwner")
  signups         Signup[]
  rotCovPrimary   SessionRotationCoverage[] @relation("RotCovPrimary")
  rotCovSecondary SessionRotationCoverage[] @relation("RotCovSecondary")

  @@index([email])
}

model FlexDay {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  label       String?
  isActive    Boolean  @default(true)
  isFinalized Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clubSessions ClubSession[]

  @@unique([date])
  @@index([date])
}

model Room {
  id        String   @id @default(cuid())
  name      String   @unique
  capacity  Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clubsWithDefault Club[]        @relation("DefaultRoom")
  sessionOverrides ClubSession[] @relation("SessionRoom")

  @@index([name])
}

model Club {
  id               String         @id @default(cuid())
  name             String
  description      String?
  maxCapacity      Int
  defaultRoomId    String?
  defaultRotations RotationSlot[]
  googleCalendarId String?        @unique
  ownerId          String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  owner        User          @relation("ClubOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  defaultRoom  Room?         @relation("DefaultRoom", fields: [defaultRoomId], references: [id], onDelete: SetNull)
  clubSessions ClubSession[]

  @@index([ownerId])
  @@index([defaultRoomId])
}

model ClubSession {
  id             String         @id @default(cuid())
  flexDayId      String
  clubId         String
  rotations      RotationSlot[]
  roomOverrideId String?
  googleEventId  String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  flexDay          FlexDay                   @relation(fields: [flexDayId], references: [id], onDelete: Cascade)
  club             Club                      @relation(fields: [clubId], references: [id], onDelete: Cascade)
  roomOverride     Room?                     @relation("SessionRoom", fields: [roomOverrideId], references: [id], onDelete: SetNull)
  signups          Signup[]
  rotationCoverage SessionRotationCoverage[]

  @@index([flexDayId])
  @@index([clubId])
  @@index([roomOverrideId])
}

model SessionRotationCoverage {
  id                 String       @id @default(cuid())
  sessionId          String
  rotation           RotationSlot
  primaryTeacherId   String?
  secondaryTeacherId String?

  session          ClubSession @relation(fields: [sessionId],          references: [id], onDelete: Cascade)
  primaryTeacher   User?       @relation("RotCovPrimary",   fields: [primaryTeacherId],   references: [id], onDelete: SetNull)
  secondaryTeacher User?       @relation("RotCovSecondary", fields: [secondaryTeacherId], references: [id], onDelete: SetNull)

  @@unique([sessionId, rotation])
  @@index([primaryTeacherId])
  @@index([secondaryTeacherId])
}

model Signup {
  id            String   @id @default(cuid())
  studentId     String
  clubSessionId String
  createdAt     DateTime @default(now())

  student     User        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  clubSession ClubSession @relation(fields: [clubSessionId], references: [id], onDelete: Cascade)

  @@unique([studentId, clubSessionId])
  @@index([studentId])
  @@index([clubSessionId])
}
